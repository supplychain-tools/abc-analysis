{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "strict": true,
    "noEmit": true,
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],

  // The test harness is excluded from the app's own project, and picked up by
  // tsconfig.test.json instead. `next build` type-checks whatever this file
  // includes, and a production install has no vitest and no playwright in it:
  // leaving them here fails the build on a missing module that the shipped
  // application never imports.
  "exclude": [
    "node_modules",
    "out",
    ".next",
    "e2e",
    "vitest.config.ts",
    "playwright.config.ts",
    "**/*.test.ts"
  ]
}
